{
    "version": 2,
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php"
        }
    },
    "routes": [
        {
            "src": "/(css|js|images|fonts|avatar.png|favicon.ico)(.*)",
            "dest": "/public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
